# openapi-typescript@7.x declares a `typescript@^5.x` peer, but this project pins
# `typescript@~6.0.3`. openapi-typescript is a devDependency only (its own bundled
# parser generates src/types/api.d.ts as a CLI step — the project's tsc version
# doesn't affect it), so the mismatch is a false conflict. Without this, every
# `npm install` / `npx expo install` fails with ERESOLVE.
legacy-peer-deps=true
